@{
    Layout = "_Layout";
    ViewData["Title"] = "My Habits";
}

<link rel="stylesheet" href="~/css/pages/view-all.css" />

<div class="habits-wrapper">
    <!-- Header Section -->
    <div class="habits-header-section">
        <div class="container">
            <h1>My Habits</h1>
            <p>Track and manage all your daily habits in one place</p>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container">
        <!-- Success Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle"></i>
                @TempData["SuccessMessage"]
            </div>
        }

        <!-- Error Message -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-error">
                <i class="bi bi-exclamation-triangle"></i>
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- Stats Bar -->
        <div class="stats-bar">
            <div class="stat-card">
                <span class="stat-number">@ViewBag.TotalHabits</span>
                <span class="stat-label">Total Habits</span>
            </div>
            <div class="stat-card">
                <span class="stat-number">@ViewBag.ActiveHabits</span>
                <span class="stat-label">Active</span>
            </div>
            <div class="stat-card">
                <span class="stat-number">@ViewBag.CompletedToday</span>
                <span class="stat-label">Done Today</span>
            </div>
            <div class="stat-card">
                <span class="stat-number">@ViewBag.TodayCompletionRate%</span>
                <span class="stat-label">Today's Rate</span>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="filter-section">
            <div class="filter-header">
                <h3>Filter Habits</h3>
            </div>
            <div class="filter-controls">
                <div class="filter-group">
                    <label class="filter-label">Frequency</label>
                    <select class="filter-select" id="frequencyFilter">
                        <option value="">All Frequencies</option>
                        <option value="Daily">Daily</option>
                        <option value="Weekly">Weekly</option>
                        <option value="Weekdays">Weekdays</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label class="filter-label">Status</label>
                    <select class="filter-select" id="statusFilter">
                        <option value="">All Status</option>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label class="filter-label">Category</label>
                    <select class="filter-select" id="categoryFilter">
                        <option value="">All Categories</option>
                        @{
                            var categories = ViewBag.Categories as List<string> ?? new List<string>();
                        }
                        @foreach (var category in categories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- Habits Grid -->
        @if (Model != null && Model.Count > 0)
        {
            <div class="habits-grid" id="habitsGrid">
                @foreach (var habit in Model)
                {
                    <div class="habit-card" data-frequency="@habit.Frequency" data-status="@(habit.IsActive ? "active" : "inactive")" data-category="@habit.Category">
                        <div class="habit-card-header">
                            <div class="habit-name">
                                <i class="bi bi-check-circle"></i>
                                @habit.Name
                            </div>
                            <div class="habit-meta">
                                <span class="frequency-badge">@habit.Frequency</span>
                                <span>@habit.Category</span>
                            </div>
                        </div>

                        <div class="habit-card-body">
                            <div class="habit-description">@habit.Description</div>

                            <div class="progress-section">
                                <div class="progress-label">
                                    <span>Current Streak</span>
                                    <span>@habit.CurrentStreak / @habit.TargetDays days</span>
                                </div>
                                <div class="progress">
                                    <div class="progress-bar" style="width: @(Math.Min((double)habit.CurrentStreak / Math.Max(habit.TargetDays, 1) * 100, 100))%" id="progress-@habit.Id"></div>
                                </div>
                            </div>

                            <div class="streak-info">
                                <div class="streak-item">
                                    <i class="bi bi-fire"></i>
                                    <span>Current: @habit.CurrentStreak days</span>
                                </div>
                                <div class="streak-item">
                                    <i class="bi bi-trophy"></i>
                                    <span>Best: @habit.LongestStreak days</span>
                                </div>
                            </div>
                        </div>

                        <div class="habit-card-footer">
                            <div class="completion-section">
                                @if (habit.LongestStreak >= habit.TargetDays)
                                {
                                    <div class="completion-status">
                                        <span class="status-text completed" style="color: #28a745; font-weight: bold;">
                                            <i class="bi bi-trophy-fill"></i> Goal Achieved!
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div class="completion-status" id="status-@habit.Id">
                                        <span class="status-text">Loading...</span>
                                    </div>
                                    <button class="card-btn btn-complete" id="complete-btn-@habit.Id" onclick="markComplete(@habit.Id)" style="display: none;">
                                        <i class="bi bi-check-circle"></i>
                                        Mark Complete
                                    </button>
                                    <button class="card-btn btn-completed" id="completed-btn-@habit.Id" style="display: none;" disabled>
                                        <i class="bi bi-check-circle-fill"></i>
                                        Completed Today
                                    </button>
                                }
                            </div>
                            <div class="action-buttons">
                                <button class="card-btn btn-edit" onclick="editHabit(@habit.Id)">
                                    <i class="bi bi-pencil"></i>
                                    Edit
                                </button>
                                <button class="card-btn btn-delete" onclick="deleteHabit(@habit.Id, '@habit.Name')">
                                    <i class="bi bi-trash"></i>
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state-wrapper">
                <div class="empty-state-icon">
                    <i class="bi bi-plus-circle"></i>
                </div>
                <h3>No habits found</h3>
                <p>You haven't created any habits yet. Start building better habits today!</p>
                <a href="@Url.Action("Create", "Habits")" class="btn-create-first">
                    <i class="bi bi-plus-circle"></i>
                    <span>Create Your First Habit</span>
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Filter functionality
        document.getElementById('frequencyFilter')?.addEventListener('change', filterHabits);
        document.getElementById('statusFilter')?.addEventListener('change', filterHabits);
        document.getElementById('categoryFilter')?.addEventListener('change', filterHabits);

        function filterHabits() {
            const frequencyFilter = document.getElementById('frequencyFilter').value.toLowerCase();
            const statusFilter = document.getElementById('statusFilter').value.toLowerCase();
            const categoryFilter = document.getElementById('categoryFilter').value.toLowerCase();

            const habitCards = document.querySelectorAll('.habit-card');

            habitCards.forEach(card => {
                const frequency = card.dataset.frequency.toLowerCase();
                const status = card.dataset.status.toLowerCase();
                const category = card.dataset.category.toLowerCase();

                const frequencyMatch = !frequencyFilter || frequency === frequencyFilter;
                const statusMatch = !statusFilter || status === statusFilter;
                const categoryMatch = !categoryFilter || category === categoryFilter;

                if (frequencyMatch && statusMatch && categoryMatch) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Edit habit function
        function editHabit(id) {
            window.location.href = '@Url.Action("Edit", "Habits")/' + id;
        }

        // Delete habit function
        function deleteHabit(id, name) {
            if (confirm(`Are you sure you want to delete "${name}"? This action cannot be undone.`)) {
                fetch('@Url.Action("Delete", "Habits")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: 'id=' + id
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while deleting the habit.');
                });
            }
        }

        // Load completion status for all habits
        function loadCompletionStatus() {
            const habitCards = document.querySelectorAll('.habit-card');
            habitCards.forEach(card => {
                const habitId = card.querySelector('.btn-complete')?.id?.replace('complete-btn-', '') ||
                               card.querySelector('.btn-completed')?.id?.replace('completed-btn-', '') ||
                               card.querySelector('.completion-status')?.id?.replace('status-', '');
                if (habitId) {
                    checkCompletionStatus(habitId);
                }
            });
        }

        // Check if habit is completed today
        function checkCompletionStatus(habitId) {
            fetch('@Url.Action("IsCompletedToday", "Habits")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: 'habitId=' + habitId
            })
            .then(response => response.json())
            .then(data => {
                const statusDiv = document.getElementById('status-' + habitId);
                const completeBtn = document.getElementById('complete-btn-' + habitId);
                const completedBtn = document.getElementById('completed-btn-' + habitId);

                if (data.isCompleted) {
                    if (statusDiv) statusDiv.innerHTML = '<span class="status-text completed"><i class="bi bi-check-circle-fill"></i> Done Today</span>';
                    if (completeBtn) completeBtn.style.display = 'none';
                    if (completedBtn) completedBtn.style.display = 'inline-block';
                } else {
                    if (statusDiv) statusDiv.innerHTML = '<span class="status-text pending"><i class="bi bi-circle"></i> Ready to Complete</span>';
                    if (completeBtn) completeBtn.style.display = 'inline-block';
                    if (completedBtn) completedBtn.style.display = 'none';
                }
            })
            .catch(error => {
                console.error('Error checking completion status:', error);
            });
        }

        // Mark habit as complete for today
        function markComplete(habitId) {
            const completeBtn = document.getElementById('complete-btn-' + habitId);
            if (completeBtn) {
                completeBtn.disabled = true;
                completeBtn.innerHTML = '<i class="bi bi-hourglass"></i> Completing...';
            }

            fetch('@Url.Action("MarkComplete", "Habits")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: 'id=' + habitId
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Update streak information
                    const card = completeBtn.closest('.habit-card');
                    const currentStreakElement = card.querySelector('.streak-item:first-child span');
                    const longestStreakElement = card.querySelector('.streak-item:last-child span');

                    if (currentStreakElement && data.currentStreak !== undefined) {
                        currentStreakElement.textContent = `Current: ${data.currentStreak} days`;
                    }
                    if (longestStreakElement && data.longestStreak !== undefined) {
                        longestStreakElement.textContent = `Best: ${data.longestStreak} days`;
                    }

                    // Update progress bar and label based on streak vs target
                    const progressBar = card.querySelector('.progress-bar');
                    const progressLabel = card.querySelector('.progress-label span:last-child');
                    
                    if (progressBar && data.currentStreak !== undefined && data.targetDays !== undefined) {
                        const progressPercentage = Math.min((data.currentStreak / Math.max(data.targetDays, 1)) * 100, 100);
                        progressBar.style.width = progressPercentage + '%';

                        // Update progress label
                        if (progressLabel) {
                            progressLabel.textContent = `${data.currentStreak} / ${data.targetDays} days`;
                        }
                    }

                    // Check if Goal Achieved
                    if (data.longestStreak >= data.targetDays) {
                         const completionSection = card.querySelector('.completion-section');
                         completionSection.innerHTML = `
                            <div class="completion-status">
                                <span class="status-text completed" style="color: #28a745; font-weight: bold;">
                                    <i class="bi bi-trophy-fill"></i> Goal Achieved!
                                </span>
                            </div>`;
                    } else {
                        // Update UI to show completed state normally
                        checkCompletionStatus(habitId);
                    }

                    // Show success message
                    showToast(data.message, 'success');
                } else {
                    // Re-enable button
                    if (completeBtn) {
                        completeBtn.disabled = false;
                        completeBtn.innerHTML = '<i class="bi bi-check-circle"></i> Complete Today';
                    }
                    showToast(data.message, 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                if (completeBtn) {
                    completeBtn.disabled = false;
                    completeBtn.innerHTML = '<i class="bi bi-check-circle"></i> Complete Today';
                }
                showToast('An error occurred while marking the habit complete.', 'error');
            });
        }

        // Toast notification function
        function showToast(message, type) {
            // Create toast element
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            toast.innerHTML = `
                <i class="bi ${type === 'success' ? 'bi-check-circle' : 'bi-exclamation-triangle'}"></i>
                <span>${message}</span>
            `;

            // Add to page
            document.body.appendChild(toast);

            // Show toast
            setTimeout(() => toast.classList.add('show'), 100);

            // Hide and remove toast
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => document.body.removeChild(toast), 300);
            }, 3000);
        }

        // Load completion status when page loads
        document.addEventListener('DOMContentLoaded', function() {
            loadCompletionStatus();
        });

        // Force reload when navigating back (fixes stale data issue)
        window.addEventListener('pageshow', function(event) {
            if (event.persisted) {
                window.location.reload();
            }
        });
    </script>
}