@model Dictionary<string, int>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Category Reports";

    // Calculate total habits for percentages
    int totalHabits = 0;
    foreach (var count in Model.Values)
    {
        totalHabits += count;
    }
}

<link rel="stylesheet" href="~/css/pages/categories.css" />

<div class="categories-wrapper">
    <!-- Categories Header Section -->
    <div class="categories-header-section">
        <h1>Category Reports</h1>
        <p>Breakdown of habits by category</p>
    </div>

    <!-- Main Content -->
    <div style="padding-top: 20px; padding-bottom: 40px;">

        @if (Model.Count > 0)
        {
            <!-- Summary Stats Grid -->
            <div class="summary-stats-grid">
                <div class="summary-stat-card">
                    <div class="summary-stat-icon primary">
                        <i class="bi bi-tags-fill"></i>
                    </div>
                    <div class="summary-stat-label">Total Categories</div>
                    <div class="summary-stat-value">@Model.Count</div>
                </div>

                <div class="summary-stat-card">
                    <div class="summary-stat-icon success">
                        <i class="bi bi-clipboard-check-fill"></i>
                    </div>
                    <div class="summary-stat-label">Total Habits</div>
                    <div class="summary-stat-value">@totalHabits</div>
                </div>

                <div class="summary-stat-card">
                    <div class="summary-stat-icon info">
                        <i class="bi bi-star-fill"></i>
                    </div>
                    <div class="summary-stat-label">Most Popular</div>
                    <div class="summary-stat-value" style="font-size: 1.8rem; font-weight: 700;">
                        @{
                            string mostPopular = "";
                            int maxCount = 0;
                            foreach (var category in Model)
                            {
                                if (category.Value > maxCount)
                                {
                                    maxCount = category.Value;
                                    mostPopular = category.Key;
                                }
                            }
                        }
                        @mostPopular
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="action-buttons-grid">
                <a href="@Url.Action("Index")" class="action-btn-modern">
                    <i class="bi bi-arrow-left"></i>
                    <span>Back to Reports</span>
                </a>
                <a href="@Url.Action("Streaks")" class="action-btn-modern">
                    <i class="bi bi-fire"></i>
                    <span>View Streaks</span>
                </a>
            </div>

            <!-- Category Details Card -->
            <div class="category-details-card">
                <div class="category-details-header">
                    <i class="bi bi-bar-chart-line-fill me-2"></i>Detailed Category Breakdown
                </div>
                <div class="category-details-body">
                    @foreach (var category in Model)
                    {
                        var percentage = totalHabits > 0 ? (double)category.Value / totalHabits * 100 : 0;
                        <div class="category-item-modern">
                            <div class="category-info">
                                <div class="category-icon-modern">
                                    <i class="bi bi-tag-fill"></i>
                                </div>
                                <div class="category-text">
                                    <div class="category-name-modern">@category.Key</div>
                                </div>
                            </div>
                            <div class="category-stats">
                                <div class="category-count-modern">@category.Value</div>
                                <div class="category-progress-modern">
                                    <div class="category-progress-bar-modern" style="width: @percentage.ToString()%" ></div>
                                </div>
                                <div class="category-percentage-modern">@percentage.ToString("0.0") %</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="empty-state-modern">
                <i class="bi bi-tags"></i>
                <h4>No Category Data Available</h4>
                <p>Start creating habits with categories to see your category breakdown here.</p>
                <a href="@Url.Action("Create", "Habits")" class="btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Create Your First Habit
                </a>
            </div>
        }
    </div>
</div>
