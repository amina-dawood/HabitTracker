    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        $(document).ready(function() {
            // Check if content is too short and add padding
            const contentHeight = $('main').height();
            const windowHeight = $(window).height();
            const navbarHeight = $('.navbar').outerHeight();
            const footerHeight = $('footer').outerHeight();

            if (contentHeight < (windowHeight - navbarHeight - footerHeight)) {
                $('main').css('min-height', (windowHeight - navbarHeight - footerHeight) + 'px');
            }

            // Add active class to current nav item
            const currentPath = window.location.pathname;
            $('.nav-link').each(function() {
                if ($(this).attr('href') === currentPath) {
                    $(this).addClass('active');
                }
            });
        });

        // Enhanced Navbar Scroll Effects
        $(window).scroll(function() {
            const scrollTop = $(this).scrollTop();
            const navbar = $('.navbar');

            if (scrollTop > 50) {
                navbar.addClass('scrolled');
            } else {
                navbar.removeClass('scrolled');
            }

            // Parallax effect for background elements
            const scrolled = scrollTop / 1000;
            $('.bg-element-1').css('transform', `translateY(${scrolled * 20}px) rotate(${scrolled * 10}deg)`);
            $('.bg-element-2').css('transform', `translateY(${scrolled * -15}px) rotate(${scrolled * -8}deg)`);
            $('.bg-element-3').css('transform', `translateY(${scrolled * 25}px) rotate(${scrolled * 12}deg)`);
        });

        // Smooth scroll for anchor links
        $('a[href^="#"]').on('click', function(event) {
            const target = $(this.getAttribute('href'));
            if (target.length) {
                event.preventDefault();
                $('html, body').stop().animate({
                    scrollTop: target.offset().top - $('.navbar').outerHeight()
                }, 800, 'easeInOutQuart');
            }
        });

        // Enhanced mobile menu
        $('.navbar-toggler').on('click', function() {
            const isExpanded = $(this).attr('aria-expanded') === 'true';
            const navbar = $('.navbar');

            if (!isExpanded) {
                navbar.addClass('mobile-open');
            } else {
                navbar.removeClass('mobile-open');
            }
        });

        // SignalR Real-time Updates
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/habitHub")
            .withAutomaticReconnect()
            .build();

        connection.start().catch(function (err) {
            return console.error(err.toString());
        });

        // Handle habit completion notifications
        connection.on("ReceiveHabitCompleted", function (habitId, habitName) {
            // Show success notification
            showNotification(`🎉 Habit "${habitName}" completed!`, 'success');

            // Update UI if on habits page
            if (window.location.pathname.includes('/Habits')) {
                updateHabitStatus(habitId, true);
            }
        });

        // Handle progress update notifications
        connection.on("ReceiveProgressUpdate", function (habitId, progress) {
            // Update progress bar if on habits page
            if (window.location.pathname.includes('/Habits')) {
                updateProgressBar(habitId, progress);
            }
        });

        // Handle general habit updates
        connection.on("ReceiveHabitUpdate", function (message, habitId) {
            showNotification(message, 'info');
        });

        // Notification system
        function showNotification(message, type = 'info') {
            const notification = $(`
                <div class="alert alert-${type} alert-dismissible fade show position-fixed" style="top: 100px; right: 20px; z-index: 9999; min-width: 300px;">
                    <i class="bi ${type === 'success' ? 'bi-check-circle' : type === 'error' ? 'bi-exclamation-triangle' : 'bi-info-circle'} me-2"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `);

            $('body').append(notification);

            setTimeout(() => {
                notification.alert('close');
            }, 5000);
        }

        // Update habit status in UI
        function updateHabitStatus(habitId, completed) {
            const habitCard = $(`.habit-card[data-habit-id="${habitId}"]`);
            if (habitCard.length) {
                const statusBadge = habitCard.find('.status-badge');
                const progressBar = habitCard.find('.progress-bar');

                if (completed) {
                    statusBadge.removeClass('status-pending').addClass('status-completed').text('Completed');
                    progressBar.css('width', '100%');
                }
            }
        }

        // Update progress bar
        function updateProgressBar(habitId, progress) {
            const habitCard = $(`.habit-card[data-habit-id="${habitId}"]`);
            if (habitCard.length) {
                const progressBar = habitCard.find('.progress-bar');
                const progressText = habitCard.find('.progress-text');

                progressBar.css('width', progress + '%');
                progressText.text(progress + '% Complete');
            }
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html> *@
