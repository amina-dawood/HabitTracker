@model HabitTracker.Areas.Admin.Models.UserListViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User Management";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 mb-0 text-gray-800">User Management</h1>
                <p class="text-muted">Manage all registered users</p>
            </div>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-xl-4 col-md-6 mb-4">
        <div class="stats-card primary">
            <div class="d-flex justify-content-between">
                <div>
                    <div class="stats-number">@Model.TotalUsers</div>
                    <div class="stats-title">Total Users</div>
                </div>
                <div class="text-primary">
                    <i class="bi bi-people-fill" style="font-size: 2rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-6 mb-4">
        <div class="stats-card success">
            <div class="d-flex justify-content-between">
                <div>
                    <div class="stats-number">@Model.ActiveUsers</div>
                    <div class="stats-title">Active Users</div>
                </div>
                <div class="text-success">
                    <i class="bi bi-person-check-fill" style="font-size: 2rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-6 mb-4">
        <div class="stats-card info">
            <div class="d-flex justify-content-between">
                <div>
                    <div class="stats-number">@Model.UsersWithEmailConfirmed</div>
                    <div class="stats-title">Verified Emails</div>
                </div>
                <div class="text-info">
                    <i class="bi bi-envelope-check-fill" style="font-size: 2rem;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Users Table -->
<div class="row">
    <div class="col-12">
        <div class="admin-card">
            <div class="card-header">
                <h6 class="m-0 font-weight-bold text-white">
                    <i class="bi bi-table me-2"></i>All Users
                </h6>
            </div>
            <div class="card-body">
                @if (Model.Users.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table admin-table">
                            <thead>
                                <tr>
                                    <th>Email</th>
                                    <th>Username</th>
                                    <th>Status</th>
                                    <th>Email Verified</th>
                                    <th>Total Habits</th>
                                    <th>Completed</th>
                                    <th>Registered</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.Users)
                                {
                                    <tr>
                                        <td>
                                            <strong>@user.Email</strong>
                                        </td>
                                        <td>@user.UserName</td>
                                        <td>
                                            @if (user.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            @if (user.EmailConfirmed)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle me-1"></i>Verified
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-hourglass-split me-1"></i>Pending
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-primary">@user.TotalHabits</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-success">@user.CompletedHabits</span>
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                @user.CreatedDate.ToString("MMM dd, yyyy")
                                            </small>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <a href="@Url.Action("UserDetails", "Home", new { area = "Admin", id = user.Id })" class="btn btn-outline-primary btn-sm" title="View Details">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a href="@Url.Action("EditUser", "Home", new { area = "Admin", id = user.Id })" class="btn btn-outline-warning btn-sm" title="Edit User">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <button class="btn btn-outline-secondary btn-sm" title="Suspend/Activate" onclick="toggleUserStatus('@user.Id')">
                                                    <i class="bi bi-slash-circle"></i>
                                                </button>
                                                @if (user.EmailConfirmed)
                                                {
                                                    <button class="btn btn-outline-danger btn-sm" title="Unverify User" onclick="unverifyUser('@user.Id')">
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-outline-success btn-sm" title="Verify User" onclick="verifyUser('@user.Id')">
                                                        <i class="bi bi-check-circle"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-users fa-4x mb-3"></i>
                        <h4>No Users Found</h4>
                        <p>There are no registered users in the system yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleUserStatus(userId) {
            if (confirm('Are you sure you want to change this user\'s status?')) {
                fetch('@Url.Action("ToggleUserStatus", "Home", new { area = "Admin" })', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: 'id=' + encodeURIComponent(userId)
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('User status updated successfully!');
                        location.reload();
                    } else {
                        alert('Error: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while updating user status.');
                });
            }
        }

        function verifyUser(userId) {
            fetch('@Url.Action("VerifyUser", "Home", new { area = "Admin" })', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'id=' + encodeURIComponent(userId)
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    alert('User verified successfully!');
                    location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            });
        }

        function unverifyUser(userId) {
            fetch('@Url.Action("UnverifyUser", "Home", new { area = "Admin" })', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'id=' + encodeURIComponent(userId)
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    alert('User unverified successfully!');
                    location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            });
        }
    </script>
}
